# Copy this file to .env and fill in your values.
# These are required for the app to work.
# Add all of these in: Vercel Dashboard → Project → Settings → Environment Variables

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Admin panel access — only this email can open the admin view
VITE_ADMIN_EMAIL=your_admin_email@gmail.com

# SHA-256 hash of your master override password (never store the plain text)
# Generate with: https://emn178.github.io/online-tools/sha256.html
VITE_MASTER_HASH=your_sha256_hash_here
