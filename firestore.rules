rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns their own data tree
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // userRegistry: users can write their own profile (for lastActive tracking),
    // but cannot read other users' registry entries — admin reads via Firebase Console only
    match /userRegistry/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if false;
    }
  }
}
