rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns their own data tree
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // userRegistry: users can write their own profile (for lastActive tracking).
    // Only the admin account can read the full collection — all other reads are denied.
    match /userRegistry/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
                  && request.auth.token.email == 'admin@gmail.com'
                  && request.auth.token.email_verified == true;
    }
  }
}
